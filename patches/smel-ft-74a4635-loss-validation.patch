@@ -0,0 +1,51 @@
+"""CPU regression tests added by IzumxAI, 2026-11-03."""
+import math
+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from smel.loss import LMHead, chunked_ce
+
+
+class LossBoundary(unittest.TestCase):
+    def setUp(self):
+        self.h = torch.randn(2, 3, requires_grad=True)
+        self.head = LMHead(weight=torch.randn(5, 3), vocab_chunk=2)
+
+    def test_invalid_targets_fail_instead_of_silent_wrong_ce(self):
+        for values in ([0, -100], [0, 5]):
+            with self.subTest(values=values), self.assertRaises(ValueError):
+                chunked_ce(self.h, self.head, torch.tensor(values), 2)
+
+    def test_invalid_denominators_and_chunks_fail(self):
+        for denom in (0, -1, float('nan'), float('inf')):
+            with self.subTest(denom=denom), self.assertRaises(ValueError):
+                chunked_ce(self.h, self.head, torch.tensor([0, 1]), denom)
+        with self.assertRaises(ValueError):
+            chunked_ce(self.h, self.head, torch.tensor([0, 1]), 2, token_chunk=0)
+        with self.assertRaises(ValueError):
+            LMHead(weight=torch.randn(5, 3), vocab_chunk=0)
+
+    def test_trainable_head_cannot_silently_lose_its_gradient(self):
+        with self.assertRaisesRegex(ValueError, 'frozen'):
+            chunked_ce(self.h, LMHead(weight=torch.randn(5, 3, requires_grad=True)),
+                       torch.tensor([0, 1]), 2)
+
+    def test_loss_and_scaled_hidden_gradient_match_full_ce(self):
+        torch.manual_seed(11)
+        hidden = torch.randn(7, 4, requires_grad=True)
+        weight = torch.randn(13, 4)
+        target = torch.tensor([0, 12, 6, 1, 11, 4, 8])
+        expected = F.cross_entropy(hidden @ weight.T, target, reduction='sum') / 9
+        (expected * 1.7).backward()
+        expected_grad = hidden.grad.clone()
+        hidden.grad = None
+        actual = chunked_ce(hidden, LMHead(weight=weight, vocab_chunk=5), target, 9, token_chunk=3)
+        (actual * 1.7).backward()
+        torch.testing.assert_close(actual, expected)
+        torch.testing.assert_close(hidden.grad, expected_grad)
+
+
+if __name__ == '__main__':
+    unittest.main()
