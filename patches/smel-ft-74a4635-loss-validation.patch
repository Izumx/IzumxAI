 def chunked_ce(h, head: LMHead, tgt, denom: float, token_chunk: int = 1024, need_grad: bool = True):
     """sum_t CE(h_t @ W.T, tgt_t) / denom. h: [N, H] (final-normed, only supervised rows), tgt: [N] long."""
+    if not math.isfinite(float(denom)) or denom <= 0:
+        raise ValueError("denom must be finite and positive")
+    if not isinstance(token_chunk, int) or token_chunk <= 0:
+        raise ValueError("token_chunk must be a positive integer")
+    weight = head.w if head.w is not None else head.q["q"]
+    if h.ndim != 2 or weight.ndim != 2 or h.shape[1] != weight.shape[1]:
+        raise ValueError("hidden and head must be matrices with matching hidden size")
+    if tgt.dtype != torch.long or tgt.ndim != 1 or tgt.shape[0] != h.shape[0]:
+        raise ValueError("targets must be one int64 token ID per hidden row")
+    if tgt.device != h.device or weight.device != h.device:
+        raise ValueError("hidden, targets and head must share a device")
+    if tgt.numel() and bool(((tgt < 0) | (tgt >= head.vocab)).any()):
+        raise ValueError("targets must be valid vocabulary IDs; filter ignore_index rows first")
